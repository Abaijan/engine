{
  "name": "engine-explainer",
  "version": "1.0.0",
  "private": true,
  "description": "An educational video about how engines work, made with Remotion",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Engine out/engine.mp4 --concurrency=50%",
    "still": "remotion still src/index.ts Engine out/preview.png --frame=3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.541",
    "@remotion/google-fonts": "4.0.541",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
